# ============================================================================
# BACKEND API CONFIGURATION
# ============================================================================

# Server Configuration
PORT=3001
NODE_ENV=development

# CORS Configuration (allow all for development, restrict in production)
CORS_ORIGIN=*

# Database Configuration (PostgreSQL)
DATABASE_URL=postgresql://user:password@localhost:5432/pokemon_app

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# ============================================================================
# THIRD-PARTY SERVICE CREDENTIALS
# ============================================================================

# Google Gemini API for AI image generation
GEMINI_API_KEY=your-gemini-api-key

# Backblaze B2 Storage for image uploads
BACKBLAZE_APPLICATION_KEY_ID=your-key-id
BACKBLAZE_APPLICATION_KEY=your-application-key
BACKBLAZE_BUCKET_ID=your-bucket-id
BACKBLAZE_BUCKET_NAME=your-bucket-name

# AWS S3 (optional, alternative to Backblaze)
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=us-east-1
AWS_S3_BUCKET_NAME=your-bucket-name

# ============================================================================
# OPTIONAL FEATURES
# ============================================================================

# Cron Job Security
CRON_SECRET=your-cron-secret

# Logging
LOG_LEVEL=info
LOG_FORMAT=json
