{
    "name": "playmoretcg-backend",
    "version": "1.0.0",
    "description": "Standalone API backend for PlayMoreTCG",
    "main": "dist/index.js",
    "scripts": {
        "dev": "tsx watch src/index.ts",
        "build": "tsc",
        "start": "node dist/index.js",
        "db:generate": "drizzle-kit generate",
        "db:migrate": "drizzle-kit migrate",
        "db:push": "drizzle-kit push",
        "db:studio": "drizzle-kit studio",
        "typecheck": "tsc --noEmit",
        "lint": "eslint --ext .ts src"
    },
    "dependencies": {
        "cors": "^2.8.5",
        "dotenv": "^16.4.5",
        "drizzle-orm": "^0.44.4",
        "express": "^4.21.0",
        "express-rate-limit": "^7.4.0",
        "helmet": "^7.1.0",
        "pg": "^8.13.0",
        "postgres": "^3.4.4",
        "zod": "^3.23.8",
        "uuid": "^10.0.0",
        "date-fns": "^4.1.0",
        "compression": "^1.7.4",
        "morgan": "^1.10.0"
    },
    "devDependencies": {
        "@types/compression": "^1.7.5",
        "@types/cors": "^2.8.17",
        "@types/express": "^4.17.21",
        "@types/morgan": "^1.9.9",
        "@types/node": "^20.16.11",
        "@types/pg": "^8.11.10",
        "@types/uuid": "^10.0.0",
        "drizzle-kit": "^0.31.4",
        "tsx": "^4.19.1",
        "typescript": "^5.6.3"
    }
}