# ============================================================================
# SECURITY CONFIGURATION - PRODUCTION CRITICAL
# ============================================================================

# Environment Configuration
NODE_ENV=development # Set to 'production' for live deployment
APP_URL=http://localhost:3000



# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================

# Primary database connection (REQUIRED)
# Format: postgresql://user:password@host:port/database
POSTGRES_URL=postgresql://user:password@localhost:5432/pokemon_app

# pg-boss job queue database (can be same as main DB)
PG_BOSS_DATABASE_URL=postgresql://user:password@localhost:5432/pokemon_app

# Database Connection Pool Settings
DB_POOL_MIN=2
DB_POOL_MAX=20
DB_POOL_IDLE_TIMEOUT=30000

# ============================================================================
# THIRD-PARTY SERVICE CREDENTIALS
# ============================================================================



# Google Gemini API for AI image generation (REQUIRED for image features)
# Get from: https://ai.google.dev/
GEMINI_API_KEY=your-gemini-api-key



# Backblaze B2 Storage (REQUIRED for image uploads)
# Get from: https://secure.backblaze.com/
BACKBLAZE_APPLICATION_KEY_ID=your-key-id
BACKBLAZE_APPLICATION_KEY=your-application-key
BACKBLAZE_BUCKET_ID=your-bucket-id
BACKBLAZE_BUCKET_NAME=your-bucket-name

# ============================================================================
# ADMIN & SECURITY CONFIGURATION
# ============================================================================

# Admin Access (set ONE of these - USER_ID takes priority)
ADMIN_USER_ID=your-admin-user-id
# ADMIN_EMAIL=admin@yourdomain.com

# Cron Job Security (REQUIRED for scheduled tasks)
# Generate with: openssl rand -base64 24
CRON_SECRET=your-cron-secret-for-scheduled-tasks

# Rate Limiting Configuration
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MS=60000 # 1 minute
RATE_LIMIT_MAX_REQUESTS=100

# Security Headers
SECURITY_HEADERS_ENABLED=true
HSTS_MAX_AGE=31536000 # 1 year
CONTENT_SECURITY_POLICY_ENABLED=true

# ============================================================================
# MONITORING & LOGGING
# ============================================================================

# Application Logging
LOG_LEVEL=info # error, warn, info, debug
LOG_FORMAT=json # json or text

# External Monitoring (Optional)
# SENTRY_DSN=your-sentry-dsn
# DATADOG_API_KEY=your-datadog-key

# Security Event Logging
SECURITY_LOGGING_ENABLED=true
SECURITY_LOG_RETENTION_DAYS=90

# ============================================================================
# FEATURE FLAGS & LIMITS
# ============================================================================

# User Limits
MAX_CARDS_PER_USER=1000
MAX_CREDITS_PER_PURCHASE=10000
WELCOME_CREDITS=50

# Image Generation Limits
MAX_IMAGE_SIZE_MB=10
MAX_IMAGES_PER_HOUR=20
ALLOWED_IMAGE_TYPES=jpg,jpeg,png,webp,gif

# File Upload Security
MAX_UPLOAD_SIZE_MB=10
VIRUS_SCANNING_ENABLED=false # Set to true if you have ClamAV or similar

# ============================================================================
# DEVELOPMENT & TESTING
# ============================================================================

# Development Mode Settings (ignored in production)
DEV_MOCK_PAYMENTS=false

# Testing
TEST_DATABASE_URL=postgresql://test:test@localhost:5432/pokemon_app_test
TEST_ADMIN_EMAIL=test-admin@example.com

# ============================================================================
# DEPLOYMENT SPECIFIC
# ============================================================================

# Vercel/Netlify deployment

# Docker deployment
DOCKER_ENV=false

# CDN Configuration
CDN_BASE_URL=https://your-cdn.com
ASSET_PREFIX=

# Health Check Configuration
HEALTH_CHECK_ENABLED=true
HEALTH_CHECK_TOKEN=your-health-check-token
