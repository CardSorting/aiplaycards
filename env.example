# NextAuth Configuration
# Generate a random string for AUTH_SECRET (you can use: openssl rand -base64 32)
AUTH_SECRET=your-secret-key-here
NEXTAUTH_SECRET=your-secret-key-here

# NextAuth URL (important for CSRF protection)
NEXTAUTH_URL=http://localhost:3000

# Database
DATABASE_URL=your-database-url



# Admin Configuration (optional)
NEXT_PUBLIC_ADMIN_EMAIL=admin@example.com
NEXT_PUBLIC_ADMIN_USER_ID=admin-user-id
ADMIN_USER_ID=admin-user-id
ADMIN_EMAIL=admin@example.com

# Other services (optional)
GEMINI_API_KEY=your-gemini-api-key
GOOGLE_GENAI_API_KEY=your-google-genai-api-key
REPLICATE_API_TOKEN=your-replicate-api-token

# Backblaze B2 Storage (optional)
B2_KEY_ID=your-b2-key-id
B2_APP_KEY=your-b2-app-key
B2_BUCKET_ID=your-b2-bucket-id
B2_BUCKET=your-b2-bucket-name
B2_REGION=your-b2-region
B2_ENDPOINT=your-b2-endpoint
B2_PUBLIC_URL=your-b2-public-url

# Stack Auth (optional)
NEXT_PUBLIC_STACK_PROJECT_ID=your-stack-project-id
NEXT_PUBLIC_STACK_PUBLISHABLE_CLIENT_KEY=your-stack-client-key
STACK_SECRET_SERVER_KEY=your-stack-server-key

# App Configuration
WELCOME_CREDITS=40
NODE_ENV=development
